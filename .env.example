# ghostreply environment configuration template
# Note: Use obviously fake values in templates. Never commit real credentials.

# Application Server
APP_HOST=127.0.0.1
APP_PORT=8000
DASHBOARD_PASSWORD=change_this_to_a_secure_dashboard_password
DATABASE_PATH=data/ghostreply.db

# WhatsApp Bridge (whatsapp-web.js)
BRIDGE_URL=http://127.0.0.1:3000
BRIDGE_SECRET=your_bridge_secret_here

# Telegram MTProto Userbot & Supervised Approval Bot
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=000000000
TELEGRAM_SESSION_FILE=data/telegram_userbot.session.enc
# Session encryption key must be provided via local unlock (HTTPS dashboard / local secret), not chat
TELEGRAM_SHADOW_MODE=true

# Operational & Safety Controls
KILL_SWITCH_ACTIVE=false
DEFAULT_LANGUAGE=en

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Path references
DATA_DIR=data
ABOUT_ME_PATH=data/about_me.md
SCHEDULE_PATH=data/schedule.json
